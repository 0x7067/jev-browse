TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay local.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional: extra Chrome flags for the launched engine, split shell-style
# (quotes group, \ escapes): JEV_CHROME_ARGS='--proxy-server=x --user-agent="A B"'
# --no-sandbox is added automatically when running as root (warns on stderr).
JEV_CHROME_ARGS=
