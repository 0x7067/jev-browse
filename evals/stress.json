  {
    "id": "form-multi",
    "url": "/form-multi.html",
    "goal": "Book for Ana Silva, ana@example.com, phone 555-0100, 3 guests, Deluxe room, arrival 2026-11-02, accept terms, note 'late arrival', then submit. Stop when submitted.",
    "script": [
      {
        "op": "TYPE_TEXT",
        "target": "^Full name",
        "text": "Ana Silva",
        "until": {
          "value": [
            "^Full name",
            "Ana Silva"
          ]
        }
      },
      {
        "op": "TYPE_TEXT",
        "target": "^Email",
        "text": "ana@example.com",
        "until": {
          "value": [
            "^Email",
            "ana@example.com"
          ]
        }
      },
      {
        "op": "TYPE_TEXT",
        "target": "^Phone",
        "text": "555-0100",
        "until": {
          "value": [
            "^Phone",
            "555-0100"
          ]
        }
      },
      {
        "op": "TYPE_TEXT",
        "target": "^Guests",
        "text": "3",
        "until": {
          "value": [
            "^Guests",
            "^3$"
          ]
        }
      },
      {
        "op": "SELECT",
        "target": "^Room",
        "option": "Deluxe",
        "until": {
          "value": [
            "^Room",
            "Deluxe"
          ]
        }
      },
      {
        "op": "TYPE_TEXT",
        "target": "^Arrival",
        "text": "2026-11-02",
        "until": {
          "value": [
            "^Arrival",
            "2026-11-02"
          ]
        }
      },
      {
        "op": "CLICK",
        "target": "I accept the terms",
        "until": {
          "checked": [
            "I accept the terms",
            "true"
          ]
        },
        "missing": "WAIT"
      },
      {
        "op": "TYPE_TEXT",
        "target": "^Notes",
        "text": "late arrival",
        "until": {
          "value": [
            "^Notes",
            "late arrival"
          ]
        }
      },
      {
        "op": "CLICK",
        "target": "Book now",
        "until": "DONE: submitted"
      }
    ],
    "expect": {
      "text_match": "name=Ana Silva[\\s\\S]*email=ana@example.com[\\s\\S]*phone=555-0100[\\s\\S]*guests=3[\\s\\S]*room=dlx[\\s\\S]*arrival=2026-11-02[\\s\\S]*terms=yes[\\s\\S]*notes=late arrival[\\s\\S]*DONE: submitted"
    },
    "done_when": "DONE: submitted"
  },
